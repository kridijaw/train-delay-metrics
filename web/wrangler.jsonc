{
  "name": "train-delay-metrics",
  "compatibility_date": "2026-11-01",
  // No "main": an assets-only Worker runs no code, so every request is a free static asset request.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "bahn.kridi.dev", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
